index 8dc223e..2d65674 100644
--- a/engine/src/game_env.cpp
+++ b/engine/src/game_env.cpp
@@ -21,10 +21,12 @@
 
 #include <cerrno>
 #include <chrono>
+#include <cstdlib>
 #include <ctime>
 #include <iostream>
 #include <ratio>
 #include <stdexcept>
+#include <vector>
 // 2026-09-10: printable HUD text validation uses std::any_of directly.
 #include <algorithm>
 #include <cmath>
@@ -841,8 +843,35 @@ void GameEnv::render(bool swap_buffer) {
   struct RestoreTracker {
     ~RestoreTracker() { GetTracker()->setDisabled(false); }
   } tracker_guard;
+  static const bool profile = [] {
+    const char* value = std::getenv("GFOOTBALL_RENDER_PHASE_PROFILE");
+    return value && std::string(value) == "1";
+  }();
+  const auto before_prepare = profile ? std::chrono::steady_clock::now() :
+                                       std::chrono::steady_clock::time_point{};
   context->gameTask->PrepareRender();
+  const auto after_prepare = profile ? std::chrono::steady_clock::now() :
+                                      std::chrono::steady_clock::time_point{};
   context->graphicsSystem.GetTask()->Render(swap_buffer);
+  if (profile) {
+    const auto after_graphics = std::chrono::steady_clock::now();
+    thread_local std::vector<double> prepare_ms;
+    thread_local std::vector<double> graphics_ms;
+    prepare_ms.push_back(std::chrono::duration<double, std::milli>(
+                             after_prepare - before_prepare).count());
+    graphics_ms.push_back(std::chrono::duration<double, std::milli>(
+                              after_graphics - after_prepare).count());
+    if (prepare_ms.size() == 150) {
+      auto report = [](const std::vector<double>& values, const char* label) {
+        std::vector<double> sorted(values.begin() + 30, values.end());
+        std::sort(sorted.begin(), sorted.end());
+        std::cerr << "RENDER_PHASE_PROFILE " << label << " p50_ms="
+                  << sorted[59] << " p95_ms=" << sorted[113] << '\n';
+      };
+      report(prepare_ms, "prepare");
+      report(graphics_ms, "graphics");
+    }
+  }
   render_presented_ = true;
 }
 
