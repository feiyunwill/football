+namespace {
+struct GpuTimerState {
+  PFNGLGENQUERIESPROC generate = nullptr;
+  PFNGLQUERYCOUNTERPROC counter = nullptr;
+  PFNGLGETQUERYOBJECTUIVPROC available = nullptr;
+  PFNGLGETQUERYOBJECTUI64VPROC result = nullptr;
+  PFNGLDELETEQUERIESPROC destroy = nullptr;
+  std::vector<std::array<GLuint, 4>> frames;
+};
+thread_local GpuTimerState gpu_timer;
+bool GpuTimerEnabled() {
+  static const bool enabled = [] {
+    const char* value = std::getenv("GFOOTBALL_GPU_TIMER_PROFILE");
+    return value && value[0] == '1' && value[1] == '\0';
+  }();
+  return enabled;
+}
+void InitializeGpuTimer() {
+  if (gpu_timer.generate) return;
+  gpu_timer.generate = reinterpret_cast<PFNGLGENQUERIESPROC>(SDL_GL_GetProcAddress("glGenQueries"));
+  gpu_timer.counter = reinterpret_cast<PFNGLQUERYCOUNTERPROC>(SDL_GL_GetProcAddress("glQueryCounter"));
+  gpu_timer.available = reinterpret_cast<PFNGLGETQUERYOBJECTUIVPROC>(SDL_GL_GetProcAddress("glGetQueryObjectuiv"));
+  gpu_timer.result = reinterpret_cast<PFNGLGETQUERYOBJECTUI64VPROC>(SDL_GL_GetProcAddress("glGetQueryObjectui64v"));
+  gpu_timer.destroy = reinterpret_cast<PFNGLDELETEQUERIESPROC>(SDL_GL_GetProcAddress("glDeleteQueries"));
+  if (!gpu_timer.generate || !gpu_timer.counter || !gpu_timer.available ||
+      !gpu_timer.result || !gpu_timer.destroy)
+    throw std::runtime_error("GPU timestamp queries are unavailable");
+}
+}
+extern "C" void FootballDumpGpuProfile() {
+  if (!GpuTimerEnabled()) return;
+  if (gpu_timer.frames.size() != 150)
+    throw std::runtime_error("GPU timestamp profile did not observe 150 frames");
+  for (size_t frame = 30; frame < gpu_timer.frames.size(); ++frame) {
+    GLuint ready = 0;
+    gpu_timer.available(gpu_timer.frames[frame][3], GL_QUERY_RESULT_AVAILABLE, &ready);
+    if (!ready) throw std::runtime_error("GPU timestamp query is incomplete");
+    GLuint64 stamp[4]{};
+    for (size_t phase = 0; phase < 4; ++phase)
+      gpu_timer.result(gpu_timer.frames[frame][phase], GL_QUERY_RESULT, &stamp[phase]);
+    if (!(stamp[0] <= stamp[1] && stamp[1] <= stamp[2] && stamp[2] <= stamp[3]))
+      throw std::runtime_error("GPU timestamps are not monotonic");
+    std::cerr << "GPU_TIMER_SAMPLE " << frame - 30 << ' '
+              << stamp[1] - stamp[0] << ' ' << stamp[2] - stamp[1] << ' '
+              << stamp[3] - stamp[2] << ' ' << stamp[3] - stamp[0] << '\n';
+    gpu_timer.destroy(4, gpu_timer.frames[frame].data());
+  }
+  for (size_t frame = 0; frame < 30; ++frame)
+    gpu_timer.destroy(4, gpu_timer.frames[frame].data());
+  gpu_timer.frames.clear();
+}
